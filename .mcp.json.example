{
  "mcpServers": {
    "n8n-mcp": {
      "command": "npx",
      "args": ["n8n-mcp"],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": "https://sua-instancia-n8n.com",
        "N8N_API_KEY": "COLE_SUA_API_KEY_AQUI"
      }
    }
  }
}

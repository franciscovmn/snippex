# Conexão com o banco (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@host:5432/database

# Autenticação
JWT_SECRET=troque-por-um-segredo-forte

# Porta do servidor
PORT=3000

# Webhook do n8n que enriquece o snippet com IA (explicação + sugestões).
# Disparado em fire-and-forget logo após o INSERT do snippet.
N8N_WEBHOOK_SNIPPEX_ENRICH=https://n8n.upciga.cloud/webhook/snippex-ai-enrich

# Yampi
# Assinatura usada para validar o webhook X-Yampi-Hmac-SHA256.
YAMPI_WEBHOOK_SECRET=troque-por-o-segredo-do-webhook
# Opcional: alias da loja, usado para ignorar eventos de outro merchant.
YAMPI_STORE_ALIAS=lojaexemplo

# Conexão com o banco (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@host:5432/database

# Autenticação
JWT_SECRET=troque-por-um-segredo-forte

# Porta do servidor
PORT=3000

# Origem permitida no CORS em produção
# Ex.: https://seu-app.vercel.app
CORS_ORIGIN=https://seu-app.vercel.app

# Webhook do n8n que enriquece o snippet com IA (explicação + sugestões).
# Disparado em fire-and-forget logo após o INSERT do snippet.
N8N_WEBHOOK_SNIPPEX_ENRICH=https://n8n.upciga.cloud/webhook/snippex-ai-enrich

# Yampi
# Credenciais da API da Yampi.
YAMPI_USER_TOKEN=seu-user-token
YAMPI_USER_SECRET_KEY=sua-user-secret-key
# Alias da loja. Se vazio, o script tenta descobrir pelo auth/me.
YAMPI_STORE_ALIAS=loja-exemplo
# Endpoint público do webhook do Snippex.
YAMPI_WEBHOOK_URL=https://seu-backend.up.railway.app/api/integrations/yampi/webhook
# Nome amigável do webhook na Yampi.
YAMPI_WEBHOOK_NAME=Snippex Yampi
# Eventos separados por vírgula.
YAMPI_WEBHOOK_EVENTS=order.created,order.paid,order.status.updated,customer.created
# Assinatura usada para validar o webhook X-Yampi-Hmac-SHA256.
YAMPI_WEBHOOK_SECRET=troque-por-o-segredo-do-webhook
# Mapeamento opcional de SKUs da Yampi para plano e ciclo.
# Formato: SKU:plano:ciclo,SKU2:plano:ciclo
# Ex.: SWYVNVE8G:pro:monthly,96TRA8KYC:pro:yearly,9RBC46XL5:team:monthly,RBJB2EJ4C:team:yearly
YAMPI_PLAN_SKU_MAP=SWYVNVE8G:pro:monthly,96TRA8KYC:pro:yearly,9RBC46XL5:team:monthly,RBJB2EJ4C:team:yearly

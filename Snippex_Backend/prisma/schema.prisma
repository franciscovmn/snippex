// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  user_name String    @unique
  email     String    @unique
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  snippets  Snippet[]
  saved_snippets SavedSnippet[]

  @@map("users")
}

model Snippet {
  id          String    @id @default(uuid()) @db.Uuid

  user_id     String    @db.Uuid
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  title       String
  type        String    @default("code")
  language    String?
  code        String    @db.Text
  is_public   Boolean   @default(false)
  explanation String?   @db.Text
  tags        String[]  @default([])
  suggestions String[]  @default([])
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)

  saved_by    SavedSnippet[]

  @@index([user_id])
  @@index([is_public])
  @@index([deleted_at])
  @@map("snippets")
}

model SavedSnippet {
  user_id    String   @db.Uuid
  snippet_id String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  snippet Snippet @relation(fields: [snippet_id], references: [id], onDelete: Cascade)

  @@id([user_id, snippet_id])
  @@index([user_id, created_at])
  @@index([snippet_id])
  @@map("saved_snippets")
}
